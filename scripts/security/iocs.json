    { "id": "pr-seed-4", "pattern": "3896884", "severity": "medium", "description": "PolinRider v2 secondary seed" },
    { "id": "pr-xor-1", "pattern": "2[gWfGj;<:-93Z^C", "severity": "critical", "description": "PolinRider XOR key (stage 1)" },
    { "id": "pr-xor-2", "pattern": "m6:tTh^D)cBz?NM]", "severity": "critical", "description": "PolinRider XOR key (stage 2)" },
    { "id": "pr-staking-uuid", "pattern": "e9b53a7c-2342-4b15-b02d-bd8b8f6a03f9", "severity": "critical", "description": "StakingGame weaponized take-home template UUID" },
    { "id": "pr-batch-propagation", "pattern": "LAST_COMMIT_DATE", "severity": "high", "regex": "LAST_COMMIT_(DATE|TIME|TEXT)", "description": "Propagation .bat fingerprint (timestamp-rewind commit amend)" }
