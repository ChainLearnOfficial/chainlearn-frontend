    { "id": "pr-decoder-v1", "pattern": "_$_1e42", "severity": "critical", "description": "PolinRider v1 decoder function name" },
    { "id": "pr-decoder-v2", "pattern": "MDy", "severity": "high", "description": "PolinRider v2 decoder function name (narrow form: function MDy)" , "regex": "function\\s+MDy\\s*\\(" },
    { "id": "pr-global-bang", "pattern": "global['!']", "severity": "critical", "description": "PolinRider v1 injection marker" },
    { "id": "pr-global-v", "pattern": "global['_V']", "severity": "critical", "description": "PolinRider v2 injection marker" },
    { "id": "pr-global-req", "pattern": "global['r']", "severity": "high", "description": "PolinRider global require shim" },
    { "id": "pr-global-mod", "pattern": "global['m']", "severity": "high", "description": "PolinRider global module shim" },
    { "id": "pr-seed-1", "pattern": "2857687", "severity": "medium", "description": "PolinRider v1 shuffle seed" },
    { "id": "pr-seed-2", "pattern": "2667686", "severity": "medium", "description": "PolinRider v1 secondary seed" },
