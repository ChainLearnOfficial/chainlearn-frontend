  "generic_patterns": [
    { "id": "gen-curl-bash", "regex": "(curl|wget)[^\\n]{0,200}\\|\\s*(bash|sh|zsh)\\b", "severity": "high", "description": "Download-and-execute pipe (loader pattern)" },
    { "id": "gen-b64-shell", "regex": "base64\\s+(-d|--decode)[^\\n]{0,60}\\|\\s*(bash|sh)\\b", "severity": "high", "description": "Base64-decode-and-execute" },
    { "id": "gen-ps-enc", "regex": "powershell[^\\n]{0,80}\\s-(enc|encodedcommand|e)\\s", "severity": "high", "description": "PowerShell encoded command (dropper)" },
    { "id": "gen-certutil", "regex": "certutil[^\\n]{0,60}(-decode|-decodehex)", "severity": "high", "description": "certutil decode (dropper)" },
    { "id": "gen-eval-decode", "regex": "eval\\s*\\(", "severity": "high", "requires_any": ["fromCharCode", "atob\\s*\\(", "unescape\\s*\\(", "String\\.fromCodePoint"], "description": "eval combined with a decoding primitive" },
    { "id": "gen-detached-spawn", "regex": "detached\\s*:\\s*true", "severity": "high", "requires_any": ["child_process", "spawn\\s*\\(", "exec\\s*\\("], "description": "Detached child process (persistence)" },
    { "id": "gen-env-spread", "regex": "(JSON\\.stringify\\(\\s*process\\.env|Object\\.entries\\(\\s*process\\.env|\\.\\.\\.process\\.env)", "severity": "high", "description": "Bulk environment-variable capture (stealer)" },
    { "id": "gen-node-e", "regex": "node\\s+-e\\s+[\"'][^\"']{200,}", "severity": "medium", "description": "Large inline node -e payload" },
    { "id": "gen-raw-ip-url", "regex": "https?://\\d{1,3}(\\.\\d{1,3}){3}[:/]", "severity": "medium", "description": "Hard-coded raw-IP URL (possible C2)" },
    { "id": "gen-bat-force-push", "regex": "push\\s+-(u[f]?|f|-force)\\b", "severity": "high", "requires_any": ["--no-verify", "commit\\s+--amend"], "description": "Force-push combined with hook bypass in a script" },
    { "id": "gen-no-verify-amend", "regex": "commit\\s+--amend[^\\n]{0,60}--no-verify", "severity": "high", "description": "History-rewriting amend with hook bypass" }
  ],

  "vscode_tasks_markers": [
